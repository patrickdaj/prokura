{
  "realm": "prokura",
  "enabled": true,
  "displayName": "Prokura",
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "registrationAllowed": false,
  "defaultDefaultClientScopes": ["basic", "profile", "mcp-audience"],
  "defaultOptionalClientScopes": ["tools:read", "tools:execute", "broker-audience", "tools-audience", "rag-audience"],
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "attributes": {
    "cibaBackchannelTokenDeliveryMode": "poll",
    "cibaExpiresIn": "30",
    "cibaInterval": "5",
    "cibaAuthRequestedUserHint": "login_hint"
  },
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@prokura.local",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-prokura"],
      "clientRoles": {
        "broker": ["read-token"]
      }
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@prokura.local",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-prokura"]
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "description": "Built-in equivalent: carries the sub claim (declaring clientScopes in an import suppresses Keycloak's own built-ins)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "Built-in equivalent: username claim",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "tools:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "tools:execute",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "broker-audience",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "token-broker-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "token-broker",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "tools-audience",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "agent-tools-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "agent-tools-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "mcp-audience",
      "description": "M4 RFC 8707 workaround: Keycloak does not reflect the resource param into aud, so a realm-default client scope binds aud=mcp-server on DCR clients; the MCP server validates it (M1 defense).",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "mcp-server-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mcp-server",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "rag-audience",
      "description": "M5: binds aud=rag-server. mcp-server carries this optional scope so rag_search can exchange an inbound MCP token into a rag-server-audience token; the RAG service validates it (F2 defense) and authorizes as user:{sub}.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "rag-server-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "rag-server",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "broker-read-token",
      "description": "Emits resource_access.broker.roles so a token presented to /broker/{alias}/token passes Keycloak's read-token check (M2 spike finding). The realm omits Keycloak's built-in 'roles' scope, so this is the minimal client-role mapper the broker needs.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "broker read-token role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "broker",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.services.clientregistration.policy.ClientRegistrationPolicy": [
      {
        "name": "Consent Required",
        "providerId": "consent-required",
        "subType": "anonymous",
        "config": {}
      },
      {
        "name": "Max Clients Limit",
        "providerId": "max-clients",
        "subType": "anonymous",
        "config": {
          "max-clients": [
            "200"
          ]
        }
      },
      {
        "name": "Full Scope Disabled",
        "providerId": "scope",
        "subType": "anonymous",
        "config": {}
      },
      {
        "name": "Allowed Protocol Mapper Types",
        "providerId": "allowed-protocol-mappers",
        "subType": "anonymous",
        "config": {
          "allowed-protocol-mapper-types": [
            "oidc-usermodel-attribute-mapper",
            "saml-user-property-mapper",
            "oidc-full-name-mapper",
            "oidc-address-mapper",
            "saml-role-list-mapper",
            "oidc-sha256-pairwise-sub-mapper",
            "saml-user-attribute-mapper",
            "oidc-usermodel-property-mapper"
          ]
        }
      },
      {
        "name": "Allowed Protocol Mapper Types",
        "providerId": "allowed-protocol-mappers",
        "subType": "authenticated",
        "config": {
          "allowed-protocol-mapper-types": [
            "saml-user-property-mapper",
            "oidc-usermodel-attribute-mapper",
            "oidc-sha256-pairwise-sub-mapper",
            "oidc-address-mapper",
            "saml-user-attribute-mapper",
            "saml-role-list-mapper",
            "oidc-usermodel-property-mapper",
            "oidc-full-name-mapper"
          ]
        }
      },
      {
        "name": "Allowed Client Scopes",
        "providerId": "allowed-client-templates",
        "subType": "anonymous",
        "config": {
          "allow-default-scopes": [
            "true"
          ]
        }
      },
      {
        "name": "Allowed Client Scopes",
        "providerId": "allowed-client-templates",
        "subType": "authenticated",
        "config": {
          "allow-default-scopes": [
            "true"
          ]
        }
      },
      {
        "name": "Allowed Registration Web Origins",
        "providerId": "registration-web-origins",
        "subType": "anonymous",
        "config": {}
      },
      {
        "name": "Trusted Hosts",
        "providerId": "trusted-hosts",
        "subType": "anonymous",
        "config": {
          "host-sending-registration-request-must-match": [
            "false"
          ],
          "trusted-hosts": [
            "127.0.0.1",
            "localhost"
          ],
          "client-uris-must-match": [
            "true"
          ]
        }
      },
      {
        "name": "Allowed Registration Web Origins",
        "providerId": "registration-web-origins",
        "subType": "authenticated",
        "config": {}
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "acme",
      "displayName": "ACME (mock external provider)",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": true,
      "addReadTokenRoleOnCreate": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "prokura-broker-idp",
        "clientSecret": "acme-idp-dev-secret",
        "clientAuthMethod": "client_secret_post",
        "authorizationUrl": "http://localhost:8180/realms/acme/protocol/openid-connect/auth",
        "tokenUrl": "http://keycloak:8080/realms/acme/protocol/openid-connect/token",
        "jwksUrl": "http://keycloak:8080/realms/acme/protocol/openid-connect/certs",
        "userInfoUrl": "http://keycloak:8080/realms/acme/protocol/openid-connect/userinfo",
        "logoutUrl": "http://localhost:8180/realms/acme/protocol/openid-connect/logout",
        "issuer": "http://localhost:8180/realms/acme",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "backchannelSupported": "false",
        "syncMode": "IMPORT",
        "defaultScope": "openid profile email"
      }
    }
  ],
  "clients": [
    {
      "clientId": "smoke-cli",
      "name": "Smoke-test CLI (dev only)",
      "publicClient": true,
      "enabled": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost/*", "http://127.0.0.1/*"],
      "webOrigins": ["+"],
      "defaultClientScopes": ["basic", "profile", "broker-read-token"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "agent-app",
      "name": "Demo agent application",
      "publicClient": false,
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "agent-app-dev-secret",
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost/*", "http://127.0.0.1/*"],
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": ["tools:read", "tools:execute", "broker-audience", "tools-audience"],
      "attributes": {
        "standard.token.exchange.enabled": "true",
        "oidc.ciba.grant.enabled": "true",
        "ciba.backchannel.token.delivery.mode": "poll"
      }
    },
    {
      "clientId": "token-broker",
      "name": "Token Broker (audience / resource)",
      "publicClient": false,
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "token-broker-dev-secret",
      "defaultClientScopes": ["basic", "broker-read-token"],
      "attributes": { "standard.token.exchange.enabled": "true" }
    },
    {
      "clientId": "agent-tools-api",
      "name": "Agent tools API (audience / resource)",
      "publicClient": false,
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "agent-tools-api-dev-secret",
      "attributes": {}
    },
    {
      "clientId": "mcp-server",
      "name": "MCP server (M4: audience/resource + exchange subject)",
      "description": "mcp-audience points here (aud target). Confidential + token-exchange enabled: the MCP server exchanges an inbound MCP token into a broker-/tools-/rag-audience token (azp=mcp-server), never forwarding the inbound token.",
      "publicClient": false,
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "mcp-server-dev-secret",
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": ["broker-audience", "tools-audience", "rag-audience"],
      "attributes": { "standard.token.exchange.enabled": "true" }
    },
    {
      "clientId": "rag-server",
      "name": "RAG retriever (M5: audience / resource)",
      "description": "aud target for rag-audience: the RAG retriever validates aud=rag-server on inbound tokens (F2 defense) and authorizes as user:{sub}. mcp-server exchanges an inbound MCP token for this audience so rag_search never forwards the inbound token.",
      "publicClient": false,
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "rag-server-dev-secret",
      "attributes": { "standard.token.exchange.enabled": "true" }
    }
  ]
}
