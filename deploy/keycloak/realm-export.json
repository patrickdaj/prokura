{
  "realm": "prokura",
  "enabled": true,
  "displayName": "Prokura",
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "registrationAllowed": false,
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "attributes": {
    "cibaBackchannelTokenDeliveryMode": "poll",
    "cibaExpiresIn": "120",
    "cibaInterval": "5",
    "cibaAuthRequestedUserHint": "login_hint"
  },
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@prokura.local",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "description": "Built-in equivalent: carries the sub claim (declaring clientScopes in an import suppresses Keycloak's own built-ins)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "Built-in equivalent: username claim",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "tools:read",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "tools:execute",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "broker-audience",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "token-broker-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "token-broker",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "tools-audience",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "agent-tools-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "agent-tools-api",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "smoke-cli",
      "name": "Smoke-test CLI (dev only)",
      "publicClient": true,
      "enabled": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost/*", "http://127.0.0.1/*"],
      "webOrigins": ["+"],
      "defaultClientScopes": ["basic", "profile"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "agent-app",
      "name": "Demo agent application",
      "publicClient": false,
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "agent-app-dev-secret",
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost/*", "http://127.0.0.1/*"],
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": ["tools:read", "tools:execute", "broker-audience", "tools-audience"],
      "attributes": {
        "standard.token.exchange.enabled": "true",
        "oidc.ciba.grant.enabled": "true",
        "ciba.backchannel.token.delivery.mode": "poll"
      }
    },
    {
      "clientId": "token-broker",
      "name": "Token Broker (audience / resource)",
      "publicClient": false,
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "token-broker-dev-secret",
      "attributes": {}
    },
    {
      "clientId": "agent-tools-api",
      "name": "Agent tools API (audience / resource)",
      "publicClient": false,
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "agent-tools-api-dev-secret",
      "attributes": {}
    }
  ]
}
