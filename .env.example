# Prokura dev environment — copy to .env. Every value here is a documented
# NON-PRODUCTION default; nothing in this file is a real secret.

# Keycloak bootstrap admin (dev only)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# OpenBao dev-mode root token (dev only — see deploy/openbao/init.sh for the
# scoped broker token the services actually use)
BAO_DEV_ROOT_TOKEN=prokura-dev-root

# Postgres
POSTGRES_USER=prokura
POSTGRES_PASSWORD=prokura-dev
POSTGRES_DB=prokura

# Demo realm user (imported via realm-export.json)
DEMO_USER=alice
DEMO_PASSWORD=alice

# Confidential client secret for the demo agent app (imported with the realm)
AGENT_APP_CLIENT_SECRET=agent-app-dev-secret
